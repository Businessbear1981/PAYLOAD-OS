# Payload — environment template
#
# Copy to .env.local and fill in. Never commit .env.local.
#
# The integrations vault (/settings/integrations) is the source of truth in
# production; these vars are the fallback path in lib/config.ts fromEnv().
# Every name below is read by that function — nothing here is decorative.

# ── required: the app will not start usefully without these ──────────

# Supabase project. url + anon_key are public; service_role_key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Credential vault encryption key — 32 bytes, base64. Required by lib/crypto.ts
# before any integration credential can be saved or read.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key means losing every stored credential. Rotate integrations,
# not the key.
INTEGRATIONS_ENCRYPTION_KEY=

# ── optional: per-vendor, only if you use that vendor ────────────────

# AI Gateway — the Claude path.
AI_GATEWAY_API_KEY=

# Cloudflare R2 (S3-compatible).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_TOKEN=
CLOUDFLARE_R2_SECRET=
R2_BUCKET=
R2_PUBLIC_URL=

# Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Media vendors.
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
HIGGSFIELD_API_KEY_ID=
HIGGSFIELD_API_SECRET=
HIGGSFIELD_API_BASE=
MESHY_API_KEY=
SUNO_API_KEY=
SUNO_API_BASE=

# Ops / platform.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
PORKBUN_API_KEY=
PORKBUN_SECRET_KEY=
RAILWAY_PROJECT_ID=
RAILWAY_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
